#    Derived Substitution Relationships with Reasoning
#################################################################

# Based on component specification
<< app:Material_103348 app:substitutes app:Material_103349 >> 
    app:inComponentContext app:Component_RuptureDisc ;
    app:substitutionConfidence 0.95 ;
    app:substitutionSource "component-specification" ;
    app:substitutionReasoning "Both materials are listed as valid options for rupture disc component in pressure valve assembly specification" .

<< app:Material_103349 app:substitutes app:Material_103348 >> 
    app:inComponentContext app:Component_RuptureDisc ;
    app:substitutionConfidence 0.85 ;
    app:substitutionSource "component-specification" ;
    app:substitutionReasoning "Reverse substitution valid but requires pressure rating verification - 103349 has higher rating" .

# Based on historical events
<< app:Material_100001941 app:substitutes app:Material_100001942 >> 
    app:inContext app:Component_Seal_Primary ;
    app:substitutionConfidence 0.98 ;
    app:substitutionSource "historical-event" ;
    app:basedOnEvent app:SubEvent_20250315_001, app:SubEvent_20250622_001 ;
    app:substitutionReasoning "Successfully substituted 2 times in similar seal contexts between 2025-03 and 2025-06" .

<< app:Material_100001942 app:substitutes app:Material_100001941 >> 
    app:inContext app:Component_Seal_Primary ;
    app:substitutionConfidence 0.98 ;
    app:substitutionSource "historical-event" ;
    app:basedOnEvent app:SubEvent_20250315_001, app:SubEvent_20250622_001 ;
    app:substitutionReasoning "Symmetric relationship - both materials successfully used interchangeably" .

<< app:Material_100001942 app:substitutes app:Material_100001949 >> 
    app:inContext app:Component_Seal_Primary ;
    app:substitutionConfidence 0.90 ;
    app:substitutionSource "historical-event" ;
    app:basedOnEvent app:SubEvent_20250810_001 ;
    app:substitutionReasoning "Emergency substitution validated in production, single occurrence" .

# Based on semantic similarity
<< app:Material_100001941 app:substitutes app:Material_100001949 >> 
    app:inContext app:Context_StandardTemp ;
    app:substitutionConfidence 0.85 ;
    app:substitutionSource "semantic-similarity" ;
    app:basedOnSimilarity << app:Material_100001941 app:semanticallySimilarTo app:Material_100001949 >> ;
    app:substitutionReasoning "Materials have 85% description similarity - both NBR NIT 90 DURO O-Rings with compatible dimensions" .

<< app:Material_889077 app:substitutes app:Material_889078 >> 
    app:inComponentContext app:Component_ControlNozzle ;
    app:substitutionConfidence 0.96 ;
    app:substitutionSource "historical-event" ;
    app:basedOnEvent app:SubEvent_20250920_001 ;
    app:basedOnSimilarity << app:Material_889077 app:semanticallySimilarTo app:Material_889078 >> ;
    app:substitutionReasoning "Historical validation plus 95% semantic similarity - Smith Series 70 nozzles with adjacent sizes" .

